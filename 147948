<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Jungle Snake</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<style>
body{
    margin:0;
    min-height:100vh;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    background:linear-gradient(#1f5f3b,#0b2e1c);
    font-family:Arial, sans-serif;
    color:white;
}

#insta{
    margin-bottom:6px;
}
#insta a{
    text-decoration:none;
    color:white;
    background:linear-gradient(45deg,#f58529,#dd2a7b,#8134af,#515bd4);
    padding:6px 14px;
    border-radius:18px;
    font-weight:bold;
}

h1{
    margin:6px 0;
}

#score{
    margin-bottom:8px;
}

#wrapper{
    position:relative;
}

canvas{
    background:#143d27;
    border-radius:16px;
    box-shadow:0 0 20px rgba(0,0,0,.6);
}

#gameOver{
    position:absolute;
    top:35%;
    left:50%;
    transform:translateX(-50%);
    font-size:34px;
    font-weight:bold;
    color:#ff4d4d;
    display:none;
}

#restart{
    position:absolute;
    top:52%;
    left:50%;
    transform:translateX(-50%);
    padding:10px 22px;
    font-size:18px;
    background:#ff4d4d;
    color:white;
    border:none;
    border-radius:12px;
    display:none;
}

.controls{
    margin-top:12px;
    display:grid;
    grid-template-columns:70px 70px 70px;
    gap:10px;
}

.controls button{
    font-size:22px;
    padding:12px;
    background:#2ecc71;
    color:#0b2e1c;
    border:none;
    border-radius:12px;
}
</style>
</head>

<body>

<div id="insta">
    <a href="https://instagram.com/xiter_tj" target="_blank"> instagram @xiter_tj</a>
</div>

<h1>🐍 JUNGLE SNAKE</h1>
<div id="score">Score: 0</div>

<div id="wrapper">
    <div id="gameOver"></div>
    <button id="restart" onclick="start()">↩️</button>
    <canvas id="game" width="300" height="300"></canvas>
</div>

<div class="controls">
    <div></div>
    <button onclick="setDir('up')">⬆️</button>
    <div></div>
    <button onclick="setDir('left')">⬅️</button>
    <button onclick="setDir('down')">⬇️</button>
    <button onclick="setDir('right')">➡️</button>
</div>

<script>
const canvas = document.getElementById("game");
const ctx = canvas.getContext("2d");

const scoreText = document.getElementById("score");
const gameOverText = document.getElementById("gameOver");
const restartBtn = document.getElementById("restart");

const box = 20;
const cells = canvas.width / box;

let snake, food, dir, run, score;

function start(){
    snake = [
        {x:140,y:140},
        {x:120,y:140},
        {x:100,y:140}
    ];
    food = randomFood();
    dir = "right";
    run = true;
    score = 0;
    scoreText.innerText = "Score: 0";
    gameOverText.style.display="none";
    restartBtn.style.display="none";
}

function randomFood(){
    return {
        x: Math.floor(Math.random()*cells)*box,
        y: Math.floor(Math.random()*cells)*box
    };
}

function setDir(d){ dir = d; }

document.addEventListener("keydown",e=>{
    if(e.key==="ArrowUp") dir="up";
    if(e.key==="ArrowDown") dir="down";
    if(e.key==="ArrowLeft") dir="left";
    if(e.key==="ArrowRight") dir="right";
});

function drawApple(){
    const cx = food.x + box/2;
    const cy = food.y + box/2;

    // apple
    ctx.beginPath();
    ctx.fillStyle="red";
    ctx.arc(cx, cy, box/2-2, 0, Math.PI*2);
    ctx.fill();

    // leaf
    ctx.beginPath();
    ctx.fillStyle="#2ecc71";
    ctx.ellipse(cx+4, cy-8, 5, 3, -0.5, 0, Math.PI*2);
    ctx.fill();
}

function drawSnake(){
    snake.forEach((p,i)=>{
        ctx.fillStyle = i===0 ? "#6aff8a" : "#2ecc71";
        ctx.fillRect(p.x+1,p.y+1,box-2,box-2);

        // eyes
        if(i===0){
            ctx.fillStyle="black";
            ctx.beginPath();
            ctx.arc(p.x+6,p.y+6,2,0,Math.PI*2);
            ctx.arc(p.x+14,p.y+6,2,0,Math.PI*2);
            ctx.fill();
        }
    });
}

function draw(){
    if(!run) return;

    ctx.clearRect(0,0,canvas.width,canvas.height);

    drawApple();
    drawSnake();

    let head = {x:snake[0].x, y:snake[0].y};

    if(dir==="up") head.y -= box;
    if(dir==="down") head.y += box;
    if(dir==="left") head.x -= box;
    if(dir==="right") head.x += box;

    if(head.x<0||head.y<0||head.x>=canvas.width||head.y>=canvas.height||
       snake.some(p=>p.x===head.x && p.y===head.y)){
        run=false;
        gameOverText.style.display="block";
        restartBtn.style.display="block";
        return;
    }

    snake.unshift(head);

    if(head.x===food.x && head.y===food.y){
        score++;
        scoreText.innerText="Score: "+score;
        food=randomFood();
    }else{
        snake.pop();
    }
}

start();
setInterval(draw,150);
</script>

</body>
</html>